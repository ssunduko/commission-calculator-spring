@startuml C4_Level2_Container
!include <C4/C4_Container>

title Container Diagram — Commission Calculator (Vertical Slice)

' ============================================================
' C4 LEVEL 2: CONTAINER DIAGRAM
' ============================================================
' Shows the deployable containers, their technology, and
' communication protocols. Reflects the actual Docker Compose
' deployment with React frontend and Spring Boot backend.
' ============================================================

Person(user, "User", "Sales rep, manager,\nor finance admin")
Person(aiAgent, "AI Agent", "Claude Desktop / Claude Code\nusing MCP protocol")

System_Boundary(commCalc, "Commission Calculator System") {

    Container(reactFrontend, "React Frontend", "Next.js / Nginx\nPort 3000", "Sales commission dashboard.\nDeals, plans, calculations,\ndisputes management UI.\nProxies API calls to backend.")

    Container(springBoot, "Spring Boot Backend", "Java 21 / Spring Boot 3.4\nPort 8081", "REST API at /api/**\nBusiness logic for deals,\nplans, calculations, disputes.\nHTTP Basic authentication.\nThymeleaf AI pages at /ai/**")

    Container(mcpServer, "MCP Server", "STDIO + Streamable HTTP\nwithin Spring Boot", "31+ tools, 10 prompts,\n12 resources for AI agents.\nAnnotation-scanned @Tool methods.\nSTDIO for Claude Desktop,\nStreamable HTTP at /mcp")

    Container(aiServices, "AI Services", "Spring AI + Claude\nwithin Spring Boot", "RAG Q&A, Explainer,\nForecasting, Anomaly Detection,\nDispute Analysis, ReAct Agent,\nMulti-Agent Workflow,\nModeration Guardrails,\nVoice Analytics")

    ContainerDb(h2db, "H2 Database", "File-based RDBMS\nVolume: /app/data", "Deals, plans, calculations,\ndisputes, users.\nFlyway-managed schema.\nPersisted via Docker volume.")

    ContainerDb(vectorStore, "SimpleVectorStore", "JSON file\nVolume: /app/data", "ONNX embeddings for\nsemantic search.\nCommission domain documents.\nPersisted via Docker volume.")
}

System_Ext(nginx, "Nginx Reverse Proxy", "Routes /api/** from\nfrontend to backend")
System_Ext(anthropicApi, "Anthropic Claude API", "Claude Sonnet 4\nLLM inference")
System_Ext(currencyMcp, "Currency MCP Server", "External: currency-mcp.wesbos.com")
System_Ext(swaggerUI, "Swagger UI", "API documentation")

' --- User interactions ---
Rel(user, reactFrontend, "Manages deals, plans,\ncalculations, disputes", "HTTPS :3000")
Rel(reactFrontend, nginx, "Proxies /api/** requests", "HTTP")
Rel(nginx, springBoot, "Forwards to backend", "HTTP :8081")

' --- AI Agent interactions ---
Rel(aiAgent, mcpServer, "Discovers and invokes\ntools, prompts, resources", "STDIO / Streamable HTTP")

' --- Internal ---
Rel(springBoot, h2db, "Reads/writes via JPA", "JDBC / Hibernate")
Rel(springBoot, vectorStore, "Semantic search\nfor RAG pipeline", "VectorStore API")
Rel(aiServices, anthropicApi, "LLM inference for\nall AI features", "HTTPS / Anthropic SDK")
Rel(aiServices, currencyMcp, "Currency conversion\nvia MCP client", "SSE transport")
Rel(mcpServer, springBoot, "Wraps service methods\nas @Tool callbacks", "Method calls")
Rel(springBoot, swaggerUI, "Serves OpenAPI spec", "HTTP /api-docs")

' ============================================================
' DIAGRAM NOTES
' ============================================================
' DEPLOYMENT:
' - React Frontend: Nginx container on port 3000
' - Spring Boot Backend: Java container on port 8081
' - Both orchestrated via Docker Compose
' - H2 database and VectorStore persist to /app/data volume
'
' PORT MAPPINGS:
' - 3000: React frontend (user-facing)
' - 8081: Spring Boot backend (API + MCP + AI pages)
' - /mcp: Streamable HTTP MCP endpoint
' - /api/**: REST API endpoints
' - /ai/**: Thymeleaf AI pages (RAG, voice, WebMCP, etc.)
'
' MCP TRANSPORT:
' - STDIO: Claude Desktop launches JAR directly
' - Streamable HTTP: MCP Inspector connects to /mcp
' - Both use the same @Tool-annotated service methods
'
' NGINX PROXY:
' - Frontend at :3000 proxies /api/** to backend :8081
' - Handles CORS, static assets, and SPA routing
' ============================================================

@enduml
